# Majburiy: Anthropic API kaliti (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ixtiyoriy sozlamalar (standart qiymatlar ko'rsatilgan)
PORT=3000
AKA_MODEL=claude-opus-5-5
# low | medium | high — chuqurroq o'ylash = aniqroq, lekin sekinroq va qimmatroq
AKA_EFFORT=medium
AKA_MAX_TOKENS=16000
# Rad javobi bo'lsa server boshqa modelga o'tadi. Bedrock/Vertex'da "off" qiling.
AKA_FALLBACKS=on
# CORS: vergul bilan ajratilgan manbalar. "chrome-extension://*" — barcha kengaytmalar.
AKA_ALLOWED_ORIGINS=chrome-extension://*
# Bir IP uchun so'rov cheklovi
AKA_RATE_MAX=40
AKA_RATE_WINDOW_MS=300000
# Reverse proxy (nginx, Render, Railway) ortida bo'lsa: 1
TRUST_PROXY=

# Ovoz (goprep.gg kabi): ElevenLabs — o'zbekcha ovoz (eleven_v3) va gapni matnga aylantirish (scribe_v2).
# Kalit: https://elevenlabs.io → Developers → API Keys. Kalit bo'lsa, Azure kerak emas.
ELEVENLABS_API_KEY=
# Ovoz: Voice Library'dan tanlab, Voice ID ni yozing. Bo'sh bo'lsa — "Will" (bIHbv24MWmeRgasZH58o), bepul ovozlar ichida o'zbekchaga eng yaqini.
# O'zbek ovozlari (pullik tarif kerak): CBeZJ4EnTnrJmhtlMCNC Sodiqjon, nXdUXfIGcAbTyJ2kC04t Abror, RaNVfTYq3HYeFPLng6XN Mirzaev
ELEVENLABS_VOICE_ID=
# Xarakter ovozlari (ixtiyoriy). Har xarakterda 2 ta: 5–9-sinf (YOSH) va 10–11-sinf/talaba (KATTA).
# Standartlari (server/voice/elevenlabs.js): Neytral — Sarhad Siz / Mirjalol, Mehribon — Shohjahon / Mirzaev,
# Kinoyali — Samariddin Siroj / Valf, Jahldor — Mirzabek / Davronbek, Romantik — Nazlı / Guzel.
# ELEVENLABS_VOICE_ID_<XARAKTER> — ikkala guruhga, ELEVENLABS_VOICE_ID_<XARAKTER>_YOSH yoki _KATTA — bittasiga.
# Xarakter tanlanmagan bo'lsa — ELEVENLABS_VOICE_ID.
# Xarakter ovozi ishlamay qolsa (masalan, kutubxonadan o'chirilsa), Jigar avtomatik ELEVENLABS_VOICE_ID ga o'tadi.
ELEVENLABS_VOICE_ID_NEYTRAL=
ELEVENLABS_VOICE_ID_MEHRIBON=
ELEVENLABS_VOICE_ID_KINOYALI=
ELEVENLABS_VOICE_ID_JAHLDOR=
ELEVENLABS_VOICE_ID_ROMANTIK=
# eleven_v4_turbo (tez, ~1 s) | eleven_v4 (sifatliroq, ~2 s) | eleven_v3
# Gapni tanish: bo'sh — Chrome (aniqroq), elevenlabs — ElevenLabs Scribe
AKA_STT=
ELEVENLABS_MODEL=eleven_v4_turbo

# Fish Audio (ixtiyoriy, arzonroq ovoz: ~$15 / 1 mln bayt). Kalit: https://fish.audio → API Keys.
# Qaysi xizmat ishlatilishini support ilova sozlamalaridan tanlaydi (hamma uchun bir xil).
FISH_API_KEY=
# Voice model ID (fish.audio kutubxonasidan). Bo'sh bo'lsa — Fish standart ovozi.
FISH_VOICE_ID=
# Xarakter ovozlari (ixtiyoriy, ElevenLabs bilan bir xil tuzilma): FISH_VOICE_ID_<XARAKTER> — ikkala yosh guruhiga,
# FISH_VOICE_ID_<XARAKTER>_YOSH (5–9-sinf) yoki _KATTA (10–11, talaba) — bittasiga.
# Xarakterlar: NEYTRAL, MEHRIBON, KINOYALI, JAHLDOR, ROMANTIK. Fish xato bersa — o'sha so'rov ElevenLabs'ga o'tadi.
# Model: drama-3 (o'zbekchada aniq, standart) yoki s2.1-pro-free (bepul, xato qiladi). Support sozlamalari ustun.
FISH_MODEL=drama-3

# Support (vergul bilan): ilova sozlamalarida xarakter, sinf va ovoz xizmatini tanlay oladi.
# Oddiy foydalanuvchilar ro'yxatdan o'tishda tanlaganida qoladi.
SUPPORT_EMAILS=

# Zaxira ovoz: Azure Speech (ElevenLabs kaliti bo'lmasa ishlatiladi). Ikkalasi ham bo'lmasa — brauzer ovozi.
# AKA_TTS=azure — ElevenLabs bo'lsa ham Azure'ning tug'ma o'zbek ovozi (inglizcha urg'u yo'q, his-tuyg'u teglari yo'q).
AKA_TTS=
# Azure portal → "Speech service" yarating → Keys and Endpoint: KEY 1 va Location/Region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# uz-UZ-SardorNeural (erkak) yoki uz-UZ-MadinaNeural (ayol)
AKA_TTS_VOICE=uz-UZ-SardorNeural
# Ruscha uchun Azure ovozi (ruscha tanlanganda)
AKA_TTS_VOICE_RU=ru-RU-DmitryNeural
# Gapirish tezligi: -10% sekinroq, 0% oddiy
AKA_TTS_RATE=-5%
AKA_TTS_RATE_MAX=300
