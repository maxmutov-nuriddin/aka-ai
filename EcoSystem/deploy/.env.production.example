# Jigar EcoSystem — SERVER sozlamalari. Nusxa: cp deploy/.env.production.example .env.production
# Bu faylni hech qachon git'ga qo'shmang (.gitignore da bor).

# --- Majburiy ---
NODE_ENV=production
ECO_LOCAL_NOAUTH=0          # internetda parolsiz kirish — HECH QACHON 1 emas
TRUST_PROXY=1               # Caddy (HTTPS) orqasida
ANTHROPIC_API_KEY=          # https://console.anthropic.com — oylik limit qo'ying!

# --- Miya va ovoz ---
ECO_LLM=haiku               # haiku (arzon) | sonnet | opus | gemini | openai
GEMINI_API_KEY=             # ovoz (Gemini TTS) va muqobil miya
ELEVENLABS_API_KEY=         # nutqni tanish ("Hey Jigar" desktop'da shu orqali) va ovoz
# AKA_EFFORT=medium

# --- Xavfsizlik ---
ECO_PROACTIVE=off           # ekranga o'zi qarash (har 10 daqiqada surat Anthropic'ga ketadi)
ECO_ACCESS=safe             # ruxsat darajasi: safe | wide | full (cheksiz — faqat ilovadan, parol bilan)
# ECO_ALLOWED_ORIGINS=      # faqat boshqa domendan API chaqiriladigan bo'lsa

# --- Ma'lumot (Docker'da shunday qoldiring) ---
# ECO_DB_FILE=/data/eco.db
# ECO_JOURNAL_DIR=/data/journal
