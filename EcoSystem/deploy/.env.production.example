# Jigar EcoSystem — server sozlamalari. Nusxa: cp deploy/.env.production.example .env.production && chmod 600 .env.production
# Bu faylni hech qachon git'ga qo'shmang va lokal .env ni serverga ko'chirmang (unda ECO_LOCAL_NOAUTH=1).

# --- Majburiy (o'zgartirmang) ---
NODE_ENV=production
ECO_LOCAL_NOAUTH=0
TRUST_PROXY=1

# --- Miya (Claude) ---
ECO_LLM=haiku
ANTHROPIC_API_KEY=
# AKA_SONNET_MODEL=
# AKA_EFFORT=

# --- Ovoz va nutqni tanish ---
# ECO_TTS: gemini | elevenlabs | fishaudio | openai
ECO_TTS=gemini
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=
# FISH_API_KEY=
# OPENAI_API_KEY=
# Azure o'zbek ovozi (bepul darajada oyiga 500 ming belgi):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# --- Fon ishlari (o'chirish: off) ---
# ECO_PROACTIVE=off
# ECO_BRIEFS=on
# ECO_MONITOR=on

# --- Boshqa manbalar (CORS). Odatda bo'sh qoldiring ---
ECO_ALLOWED_ORIGINS=
