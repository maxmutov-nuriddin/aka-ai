# Jigar EcoSystem — CRM'ning Caddy'si orqali (HTTPS sertifikatini Caddy o'zi oladi).
ecosystem.myjigar.uz {
	encode zstd gzip
	# Oqimli javoblar (chat NDJSON) buferlanmasin
	reverse_proxy jigar:3100 {
		flush_interval -1
		transport http {
			read_timeout 120s
		}
	}
	request_body {
		max_size 20MB
	}
}
