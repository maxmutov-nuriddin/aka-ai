# Bosh domen (myjigar.uz, www): hozircha faqat "Soon…" sahifasi. Jigar o'zi ecosystem.myjigar.uz da.
# DNS: ahost'da `@` A-yozuvi serverga (169.58.115.116) qaratilgan bo'lishi kerak (www — CNAME → myjigar.uz).
myjigar.uz, www.myjigar.uz {
	encode zstd gzip
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-cache"
	respond `<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Soon…</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { display: grid; place-items: center; background: #0b0e22; color: #e9ecff;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  h1 { margin: 0; font-size: clamp(40px, 9vw, 96px); font-weight: 800; letter-spacing: -0.02em; }
</style>
</head>
<body>
<h1>Soon…</h1>
</body>
</html>
` 200
}
