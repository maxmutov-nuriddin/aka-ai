{
  "name": "jigar-desktop",
  "version": "2.0.0",
  "description": "Jigar — shaxsiy yordamchi (desktop)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --universal",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --arm64",
    "dist:win-zip": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win zip --x64 -c.win.signAndEditExecutable=false -c.win.artifactName='Jigar-win.${ext}'",
    "dist:win-exe": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false -c.win.artifactName='Jigar-win.${ext}'"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "uz.jigar.eco",
    "productName": "Jigar",
    "files": [
      "main.js",
      "bridge.js",
      "tools.js",
      "policy.js",
      "control.js",
      "scripts.js",
      "os-run.js",
      "youtube.js",
      "icon.png",
      "tv.js",
      "power.js",
      "dev.js",
      "messages.js",
      "screen-text.js",
      "server-url.js",
      "setup-preload.js",
      "app-preload.js",
      "permissions.js",
      "permission-policy.js",
      "load-url.js",
      "status-pill.js",
      "pill-policy.js",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "tray-listenTemplate.png",
      "tray-listenTemplate@2x.png",
      "tray-speakTemplate.png",
      "tray-speakTemplate@2x.png",
      "setup.html",
      "youtube-search.js",
      "access-cap.js",
      "home.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "artifactName": "Jigar-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jigar sizni eshitishi uchun mikrofon kerak (savol, \"Hey Jigar\").",
        "NSCameraUsageDescription": "Jigarga kamerada narsa ko'rsatish uchun.",
        "NSAppleEventsUsageDescription": "Jigar ilovalarni ochish, yashirish va boshqarish uchun."
      }
    },
    "win": {
      "target": "nsis",
      "artifactName": "Jigar-win.${ext}"
    }
  },
  "jigar": {
    "serverUrl": "https://ecosystem.myjigar.uz"
  }
}
