# Jigar EcoSystem — shaxsiy yordamchi. Global'dan ALOHIDA .env (kalitlarni ham alohida olish tavsiya etiladi).
# Nusxa: cp .env.example .env

# Server
PORT=3100
# HOST=127.0.0.1   # faqat shu kompyuter; standart 0.0.0.0 (Wi-Fi'dagi qurilmalar ham)
# ECO_DB_FILE=data/eco.db

# Kirish: faqat shu emaillar ro'yxatdan o'ta oladi (vergul bilan). Bo'sh — hamma (faqat lokal sinov uchun!).
ECO_OWNER_EMAILS=

# Miya: claude | haiku | gemini | openai   (internet qidiruvi faqat claude/haiku'da)
ECO_LLM=claude
ANTHROPIC_API_KEY=
# AKA_MODEL=claude-opus-5-5
# AKA_EFFORT=medium

# Ovoz: gemini | elevenlabs | fishaudio | openai
ECO_TTS=gemini
GEMINI_API_KEY=
# Nutqni tanish (ElevenLabs Scribe) — bo'lmasa brauzer (Chrome) tanishi
ELEVENLABS_API_KEY=
# FISH_API_KEY=
# OPENAI_API_KEY=
# ECO_STT=chrome   # faqat brauzer tanishi

# Desktop/mobil ilovalar manzillari (CORS), vergul bilan: masalan tauri://localhost,capacitor://localhost
ECO_ALLOWED_ORIGINS=
# Internetga chiqarilganda (HTTPS orqasida)
# NODE_ENV=production
# TRUST_PROXY=1
