{
  "manifest_version": 3,
  "name": "Jigar — o'quv yordamchisi",
  "short_name": "Jigar",
  "version": "1.0.0",
  "description": "Ko'rayotgan sahifangni oddiy, jaydari tilda tushuntirib beradigan do'st.",
  "action": {
    "default_title": "Jigarni ochish",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "app/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
